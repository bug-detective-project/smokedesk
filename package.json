{
  "name": "smokedesk-qa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bugDetective": {
    "project": {
      "id": "smokedesk",
      "name": "Smoke Desk",
      "difficulty": "beginner",
      "stack": {
        "frontend": "React · Vite · CSS Modules",
        "backend": "Node.js · Express (API and audit service)",
        "database": "PostgreSQL · MySQL"
      },
      "services": {
        "notes-db": {
          "image": "postgres:17",
          "memory": "256m",
          "env": {
            "POSTGRES_PASSWORD": "smokedesk",
            "POSTGRES_DB": "notes"
          },
          "variables": {
            "NOTES_DATABASE_URL": "postgres://postgres:smokedesk@{{host}}:{{port}}/notes"
          }
        },
        "audit-db": {
          "image": "mysql:8.4",
          "memory": "512m",
          "env": {
            "MYSQL_ROOT_PASSWORD": "smokedesk",
            "MYSQL_DATABASE": "audit"
          },
          "variables": {
            "AUDIT_DATABASE_URL": "mysql://root:smokedesk@{{host}}:{{port}}/audit",
            "MYSQL_HOST": "{{host}}",
            "MYSQL_TCP_PORT": "{{port}}"
          }
        }
      },
      "ports": {
        "client": {
          "port": 5173,
          "open": true,
          "label": {
            "en": "Smoke Desk",
            "pt": "Smoke Desk"
          },
          "variables": {
            "CLIENT_ORIGIN": "http://localhost:{{port}}"
          }
        },
        "api": {
          "port": 3001
        },
        "audit": {
          "port": 3002,
          "label": {
            "en": "Audit service",
            "pt": "Serviço de auditoria"
          },
          "variables": {
            "VITE_AUDIT_URL": "http://localhost:{{port}}"
          }
        }
      }
    }
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "qa": "node run.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "playwright install chromium",
    "test": "vitest run"
  },
  "devDependencies": {
    "@bug-detective/catalog": "github:bug-detective-project/catalog#v1.9.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
