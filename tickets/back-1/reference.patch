+++ b/server/src/notes-delete-audit.test.ts
@@ -0,0 +1,60 @@
+import { createServer } from 'node:http';
+import type { Server } from 'node:http';
+import type { AddressInfo } from 'node:net';
+import type { Express } from 'express';
+import type pg from 'pg';
+import request from 'supertest';
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'vitest';
+import { createApp } from './app.ts';
+import { auditClient } from './audit-client.ts';
+import { resetDatabase } from './db.ts';
+import { testDatabase } from './test/database.ts';
+
+/** A stand-in for the audit service, on a port of its own: keeps every event the API posts. */
+const received: unknown[] = [];
+let audit: Server;
+let pool: pg.Pool;
+let app: Express;
+
+beforeAll(async () => {
+  audit = createServer((req, res) => {
+    let body = '';
+    req.on('data', (chunk) => (body += chunk));
+    req.on('end', () => {
+      received.push({ method: req.method, path: req.url, event: JSON.parse(body) });
+      res.writeHead(201).end();
+    });
+  });
+  await new Promise<void>((resolve) => audit.listen(0, '127.0.0.1', resolve));
+  pool = await testDatabase();
+  const { port } = audit.address() as AddressInfo;
+  app = createApp({ pool, sendEvent: auditClient(`http://127.0.0.1:${port}`) });
+});
+
+beforeEach(async () => {
+  await resetDatabase(pool);
+  received.length = 0;
+});
+
+afterAll(async () => {
+  await pool.end();
+  audit.close();
+});
+
+describe('deleting a note', () => {
+  it('tells the audit service which note was deleted', async () => {
+    const response = await request(app).delete('/api/notes/2').set('Host', 'localhost:3001');
+
+    expect(response.status).toBe(204);
+    expect(received).toEqual([
+      { method: 'POST', path: '/events', event: { action: 'deleted', noteId: 2, text: 'Badge for the new intern' } },
+    ]);
+  });
+
+  it('tells it nothing when there was no such note', async () => {
+    const response = await request(app).delete('/api/notes/99').set('Host', 'localhost:3001');
+
+    expect(response.status).toBe(404);
+    expect(received).toEqual([]);
+  });
+});
